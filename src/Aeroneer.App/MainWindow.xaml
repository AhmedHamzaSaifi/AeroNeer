<Window x:Class="Aeroneer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aeroneer | Candidate registration"
        Width="1120" Height="820" MinWidth="780" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        Loaded="OnWindowLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="AERONEER" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Candidate registration" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="LOCAL DATABASE REQUIRED" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" Padding="26" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <Label Content="Company / institute" />
                        <TextBox x:Name="CompanyBox" Text="{Binding CompanyOrInstitute, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <Label Content="First name *" />
                        <TextBox x:Name="FirstNameBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <Label Content="Last name *" />
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <Label Content="Country *" />
                        <ComboBox ItemsSource="{Binding Countries}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedItem="{Binding SelectedCountry, UpdateSourceTrigger=PropertyChanged}" IsTextSearchEnabled="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <Label Content="Address" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <Label Content="Birth date *" />
                        <DatePicker SelectedDate="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <Label Content="Zip code" />
                        <TextBox Text="{Binding ZipCode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <Label Content="Place" />
                        <TextBox Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <Label Content="Gender" />
                        <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <Label Content="Telephone" />
                        <TextBox Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2">
                        <Label Content="E-mail *" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0" />
            <Button Grid.Column="1" Content="Save candidate" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</Window>
