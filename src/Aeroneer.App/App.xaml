<Application x:Class="Aeroneer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101820" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1B2935" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D9A441" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#62C6B5" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F5F7" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A9BAC6" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101820" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#415361" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,3,12,8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#101820" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#415361" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,3,12,8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#101820" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,3,12,8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#101820" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Application.Resources>
</Application>
